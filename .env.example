# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/single_product_saas?schema=public"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Admin dashboard auth (single owner)
# ---------------------------------------------------------------------------
ADMIN_PASSWORD="change-me-strong-password"
SESSION_SECRET="change-me-32-plus-random-characters-long"

# ---------------------------------------------------------------------------
# PayPal (Developer dashboard -> REST apps)
# ---------------------------------------------------------------------------
PAYPAL_ENV="sandbox"                       # sandbox | live
NEXT_PUBLIC_PAYPAL_ENV="sandbox"
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_CURRENCY="USD"

# ---------------------------------------------------------------------------
# Telegram notifications
# (can also be set from the dashboard -> saved in DB, these are fallbacks)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---------------------------------------------------------------------------
# AI chatbot (Gemini or OpenAI)
# ---------------------------------------------------------------------------
AI_PROVIDER="gemini"                       # gemini | openai
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL=""                                # e.g. gemini-1.5-flash / gpt-4o-mini
